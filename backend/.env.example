# ── 데이터베이스 ──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/news_curator

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── JWT 인증 ──
SECRET_KEY=your-secure-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── 네이버 뉴스 API ──
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# ── LLM 엔진 설정 (NFR-E03: 환경변수로 유연하게 교체) ──
# 1순위: 로컬 Ollama (Llama 3)
LLM_PRIMARY_MODEL=llama3
LLM_PRIMARY_BASE_URL=http://localhost:11434/v1
# 2순위: Claude (API 키 비어있으면 건너뜀)
LLM_FALLBACK_CLAUDE_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
# 3순위: OpenAI 호환 원격 (API 키 비어있으면 건너뜀)
LLM_FALLBACK_OPENAI_MODEL=gpt-4o-mini
LLM_FALLBACK_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# ── Ko-SBERT 모델 ──
EMBEDDING_MODEL_NAME=snunlp/KR-SBERT-V40K-klueNLI-augSTS

# ── 디버그 모드 ──
DEBUG=true
