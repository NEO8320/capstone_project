# ============================================================
# News Curator — 환경변수 템플릿 (.env.example)
# ============================================================
# 사용 방법:
#   1) 이 파일을 같은 디렉터리에 ".env" 로 복사한다.
#        backend/.env.example  →  backend/.env
#   2) 아래 각 키의 "값 부분만" 채워서 저장한다.
#        (키 이름 자체는 바꾸지 말 것)
#   3) .env 파일은 .gitignore 에 등록되어 있어 커밋되지 않는다.
#      실제 API 키는 절대로 git 에 올리지 말 것.
#
# API 키 발급처:
#   • NAVER_CLIENT_*  : https://developers.naver.com/apps/   (검색 API → 뉴스)
#   • OPENAI_API_KEY  : https://platform.openai.com/api-keys (CT-02 분류, 선택)
#   • ANTHROPIC_API_KEY: https://console.anthropic.com/      (미사용, 선택)
#   • SECRET_KEY      : `openssl rand -hex 32` 또는 `python -c "import secrets; print(secrets.token_hex(32))"`
# ============================================================

# ── 데이터베이스 (docker-compose 기본값과 맞음) ────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/news_curator

# ── Redis 캐시 ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT 인증 ──────────────────────────────────────────────
# ※ 반드시 32바이트 이상의 임의 문자열로 교체할 것. 빈 값이면 서버 기동 불가.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 네이버 뉴스 검색 API (필수) ────────────────────────────
# 값을 채우지 않으면 크롤러가 동작하지 않는다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── LLM — 1순위: 로컬 Ollama (기본값 그대로 사용 권장) ──
LLM_PRIMARY_MODEL=llama3
LLM_PRIMARY_BASE_URL=http://localhost:11434/v1

# ── LLM — 2순위: Anthropic Claude (선택, 현재 미사용) ──
LLM_FALLBACK_CLAUDE_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# ── LLM — 3순위: OpenAI 호환 (선택, CT-02 GPT 분류에 사용) ──
# 비어 있으면 CT-02 가 자동으로 크롤러 섹션 카테고리로 폴백한다.
LLM_FALLBACK_OPENAI_MODEL=gpt-4o-mini
LLM_FALLBACK_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# ── Ko-SBERT 임베딩 모델 (기본값 그대로) ───────────────────
EMBEDDING_MODEL_NAME=snunlp/KR-SBERT-V40K-klueNLI-augSTS
EMBEDDING_DIM=768

# ── 크롤링 스케줄 ─────────────────────────────────────────
CRAWL_INTERVAL_HOURS=1
CRAWL_ON_STARTUP=True
AUTO_SEED_ON_EMPTY_DB=True
STARTUP_CRAWL_RETRY_ON_ZERO=1

# ── 기타 ──────────────────────────────────────────────────
RATE_LIMIT=60/minute
FEED_CACHE_TTL=300
DEBUG=false
